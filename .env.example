# Optional server configuration. Never put real keys in public source.
# Local .env is ignored. Hosted values belong in your host's secret store.
OPENAI_API_KEY=
OPENAI_MODEL=
# Explicit per-owner provider consent is also required in the app.
META_APP_SECRET=
META_VERIFY_TOKEN=
# Choose the version currently supported by your registered Meta app.
META_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Copy your authenticated Site user ID from server-side identity, not your email.
MERCHANT_OWNER_ID=
LIVE_SEND_ENABLED=false
